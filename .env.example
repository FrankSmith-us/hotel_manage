# Server
PORT=3001
JWT_SECRET=change-this-secret-in-production
DEMO_ROLE_SWITCH=true

# Database: mysql (production) or sqlite (zero-install local demo)
DB_CLIENT=mysql

# MySQL 8.0 settings (used when DB_CLIENT=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hotel_ops
DB_PASSWORD=hotel_ops_pass
DB_NAME=hotel_manage

# SQLite settings (used when DB_CLIENT=sqlite)
SQLITE_PATH=./data/hotel_manage.db
