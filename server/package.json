{
  "name": "yueqi-hotel-ops-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:demo": "node -e \"process.env.DB_CLIENT='sqlite';\" && tsx watch --env-file=../.env.example src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "db:init": "tsx db/init.ts",
    "db:seed": "tsx db/seed.ts",
    "db:reset:demo": "tsx db/init.ts && tsx db/seed.ts --reset",
    "test": "tsx --test tests/api.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
